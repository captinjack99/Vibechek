analysis.json
analysis.zip
analysis_*.json
analysis_diff.txt
tags_backup.json
safe_duplicates.json
suspect_duplicates.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anchored to repo root: an unanchored `lib/` also matched `ui/src/lib/`
# (the frontend's keeperRules/keeperConstants source), so those files were
# silently never committed — which broke `tsc`/`npm run build` on every fresh
# checkout (CI + clones). Only the Python build-output lib dirs at the root
# should be ignored.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
MANIFEST
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Virtual environments
.venv/
venv/
env/
ENV/

# --- Node / Frontend ---
node_modules/
.vite/
*.tsbuildinfo
# Vite build output for the UI
ui/dist/

# --- Rust / Tauri ---
target/
ui/src-tauri/target/
ui/src-tauri/gen/
# PyInstaller'd sidecar binaries dropped into the bundle dir at release time
ui/src-tauri/binaries/

# --- ML models (downloaded on first run, ~800MB) ---
models/
*.pb

# --- Frontend test artifacts ---
ui/coverage/
ui/.vitest-cache/
ui/.vite-cache/

# --- Tauri / Rust build artifacts (in addition to target/ above) ---
# Note: Cargo.lock IS committed (Tauri shell is a binary, not a library)
ui/src-tauri/WixTools/

# --- PyInstaller scratch dirs (some emit into the repo root) ---
*.spec.bak
pyinstaller.log

